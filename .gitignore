node_modules
# Frontend build output. We commit `dist/index.html` as a stub so
# `cargo install --git` (and crates.io builds) work without `npm run build`.
# Everything else under dist/ is regenerated by `npm run build`.
dist/*
!dist/index.html
dist-ssr
*.local

